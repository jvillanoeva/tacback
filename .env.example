PORT=3000
BASE_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# QR signing
QR_SECRET=change-this-to-a-random-string

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=tickets@colectivo.live

# Service auth — shared bearer token for headless callers (clau on Lola)
# Used by POST /api/internal/* . Generate a long random string; set the SAME
# value here (Railway env) and on Lola in clau's environment. Never commit it.
SERVICE_AUTH_TOKEN=change-this-to-a-long-random-string
